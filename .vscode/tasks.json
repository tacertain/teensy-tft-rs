{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Embedded Rust Project",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--release"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$rustc"
			],
			"isBackground": false
		}
	]
}